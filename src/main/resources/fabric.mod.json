{
  "schemaVersion": 1,
  "id": "follow-me",
  "version": "${version}",
  "name": "Follow Me",
  "description": "Follow another player, or have them follow you, riding along behind",
  "authors": [
    "justfatlard"
  ],
  "contact": {
    "sources": "https://github.com/fatlard1993/follow-me"
  },
  "license": "MIT",
  "icon": "assets/follow-me/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "justfatlard.follow_me.Main"
    ]
  },
  "mixins": [
    "follow-me.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loaderVersion}",
    "fabric-api": "${fabricApiVersion}",
    "minecraft": "${minecraftDependency}",
    "java": ">=25",
    "pandorical": ">=15.37.0"
  },
  "suggests": {
    "big-boats-justfatlard": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.donate": "https://github.com/sponsors/fatlard1993"
      }
